{
  "manifest_version": 3,
  "name": "YouTube No Video Length",
  "version": "0.2.0",
  "description": "Spoiler-free YouTube: hides video lengths, the progress bar and other hints of how much is left.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-no-video-length@henrikrosander.github.io",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/HenrikRosander/Youtube-No-Video-Length/main/updates.json"
    }
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "YouTube No Video Length",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "css": ["content/hide.css"],
      "js": ["content/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
