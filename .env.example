# Mozilla add-on signing credentials, from
# https://addons.mozilla.org/developers/addon/api/key/
#
# For releases you don't need this file: add these values as GitHub repo
# secrets instead (Settings -> Secrets and variables -> Actions):
#   AMO_API_KEY    = the JWT issuer
#   AMO_API_SECRET = the JWT secret
#
# This file is only for signing on your own machine. Copy it to .env (which
# git ignores), fill it in, then run from Git Bash:
#   set -a; source .env; set +a
#   npx web-ext@8 sign --channel=unlisted --ignore-files updates.json README.md
#
# Signing locally uses up that version number: Mozilla never signs the same
# version twice, so a tagged release of it would then fail.

WEB_EXT_API_KEY=user:00000000:000
WEB_EXT_API_SECRET=replace-with-your-jwt-secret
